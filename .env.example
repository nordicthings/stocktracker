# Copy to .env and adjust for a local MariaDB instance.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stocktracker
DB_USERNAME=stocktracker
DB_PASSWORD=replace-with-your-password
DB_ROOT_PASSWORD=replace-with-your-root-password

# SMTP configuration for shopping-list emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=stocktracker@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SHOPPING_LIST_EMAIL_FROM=stocktracker@example.com
SHOPPING_LIST_EMAIL_RECIPIENTS=recipient-one@example.com,recipient-two@example.com
# CHANGED_ITEMS_BELOW_MINIMUM_STOCK or CHANGED_ITEMS_BELOW_TARGET_STOCK
SHOPPING_LIST_EMAIL_CONDITION=CHANGED_ITEMS_BELOW_TARGET_STOCK
# Spring cron expression: second minute hour day-of-month month day-of-week; '-' disables the automatic check.
SHOPPING_LIST_EMAIL_SCHEDULE=0 0 9 * * MON,WED,FRI
